        {
          "id": "da714e1f-2f5f-4315-a18a-a0471dc0fd93",
          "name": "Create Commit Transaction",
          "request": {
            "name": "Create Commit Transaction",
            "description": {
              "content": "MKACTIVITY — creates a new commit transaction (activity) on the server. Returns a URL to the activity resource used in subsequent CHECKOUT and MERGE requests. This is the first step of every SVN commit.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "$svn",
                "act",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Repository name",
                  "type": "any",
                  "value": "{{repository}}",
                  "key": "repository"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "key": "X-SVN-Options",
