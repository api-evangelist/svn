        {
          "id": "d25ce378-7253-4e1c-a53f-c264d9590dc6",
          "name": "Abort Commit Transaction",
          "request": {
            "name": "Abort Commit Transaction",
            "description": {
              "content": "Abort an in-progress commit transaction by deleting the activity resource. This rolls back all staged changes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "$svn",
                "act",
                ":txn-id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "txn-id",
                  "description": "(Required) Transaction ID from MKACTIVITY"
                },
                {
                  "description": "Repository name",
                  "type": "any",
                  "value": "{{repository}}",
                  "key": "repository"
                }
              ]
            },
            "method": "DELETE",
            "auth": null
